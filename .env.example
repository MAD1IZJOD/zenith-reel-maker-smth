# Absolute paths are optional when ffmpeg and ffprobe are on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# One long-running Node process only. Never share this disk between app instances.
DATA_DIR=./data
# Startup + every-minute cleanup while the host is running. Active jobs are protected.
RETENTION_HOURS=24
# Browser uploads are additionally guarded by server validation.
MAX_UPLOAD_MB=80
MAX_CLIP_DURATION=90
MAX_CONCURRENT_UPLOADS=2
MAX_CONCURRENT_RENDERS=1
MAX_PENDING_RENDERS=8
# Optional override; defaults to Arial Bold on Windows and DejaVu Sans Bold on Linux.
# FFMPEG_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# Configure for hosted HTTPS. Leave unset for local development.
# PUBLIC_BASE_URL=https://studio.example.org
# Vercel only: redirect visitors to the persistent studio host. Do not set on the laptop.
# STUDIO_ORIGIN=https://studio.example.org
# Secure cookies default true in production. Set false ONLY for localhost production tests.
# COOKIE_SECURE=true
# Enable only behind the supplied exclusively exposed reverse proxy.
TRUST_PROXY=false
# Operator features stay disabled until a random secret of at least 32 characters is set.
OPERATOR_SECRET=
ENABLE_LEADERBOARD=false
# Docker Compose activation: use a domain you control; no public URL is provisioned by this repository.
# STUDIO_DOMAIN=studio.example.org
# IMAGE_TAG=phase4
# Rendering: libx264 is the verified default. RENDER_ENCODER=h264_amf only after `npm run benchmark:render` passes on this host.
# RENDER_ENCODER=libx264
# RENDER_THREADS=4
# Local creative model (server-side only). auto discovers Qwen in Ollama, then an OpenAI-compatible server.
CREATIVE_MODEL_PROVIDER=auto
# CREATIVE_MODEL_URL=http://127.0.0.1:11434
# CREATIVE_MODEL=qwen3:8b
# CREATIVE_MODEL_TIMEOUT_MS=75000
# Local transcription (faster-whisper in .venv-transcribe; see README). Models: tiny, base, small (+ .en).
# TRANSCRIBE_MODEL=base
# TRANSCRIBE_THREADS=4
# TRANSCRIBE_PYTHON=
# Video/podcast sources.
MAX_SOURCE_MB=1024
MAX_SOURCE_MINUTES=90
# Optional, billable Higgsfield generative edits. Credentials come from console.higgsfield.ai (API access is
# separate from any website plan). Stays disabled unless ENABLE_HIGGSFIELD=true.
ENABLE_HIGGSFIELD=false
# HIGGSFIELD_KEY_ID=
# HIGGSFIELD_KEY_SECRET=

# Names and emails are private; retained separately from 24-hour media (1–365 days).
REGISTRATION_RETENTION_DAYS=30
