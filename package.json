  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/presets/presets.test.ts src/lib/creative/options.test.ts src/lib/creative/challenges.test.ts src/lib/camera/capabilities.test.ts src/lib/ai/studio.test.ts src/lib/video/shot-analysis.test.ts src/lib/creative/timeline.test.ts src/lib/edit/edl.test.ts src/lib/video/ass.test.ts tests/server/upload-validation.test.ts tests/server/creative-provider.test.ts tests/server/sources.test.ts tests/server/highlights.test.ts tests/server/higgsfield.test.ts && tsx scripts/verify-render.ts && tsx scripts/verify-creative-render.ts",
    "generate:audio": "tsx scripts/generate-audio.ts",
    "verify:remix": "tsx --test tests/server/remix.test.ts",
    "verify:finishing": "tsx scripts/verify-finishing-render.ts",
    "verify:beats": "tsx scripts/verify-beat-render.ts",
    "generate:samples": "node scripts/generate-samples.mjs",
    "smoke:render": "tsx scripts/render-smoke.ts",
    "verify:render": "tsx scripts/verify-render.ts",
    "verify:api": "tsx scripts/verify-api.ts",
    "verify:browser": "playwright test",
    "generate:previews": "tsx scripts/generate-previews.ts",
    "verify:aesthetics": "tsx scripts/verify-aesthetics.ts",
    "fixtures:fetch": "tsx scripts/fetch-fixtures.ts",
    "verify:qwen": "tsx scripts/verify-qwen.ts",
    "verify:transcription": "tsx scripts/verify-transcription.ts",
    "verify:highlights": "tsx scripts/verify-highlight-render.ts",
    "verify:speech": "tsx scripts/verify-speech-captions.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "postcss": "^8.5.31"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "next": "^15.3.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.64.1",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.25.0",
    "eslint-config-next": "^15.3.2",
    "tsx": "^4.19.3"
  }
